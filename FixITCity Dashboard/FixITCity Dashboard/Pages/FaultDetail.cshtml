@page "{id:int}"
@model FixITCity_Dashboard.Pages.FaultDetailModel
@{
    ViewData["Title"] = "Fault Detail";
    Layout = "_SidebarLayout";
}

<style>
    .fault-detail-container {
        background: #fff;
        padding: 1.5rem;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }

    .fault-header h2 {
        color: #009688;
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .fault-header p {
        color: #666;
        margin-bottom: 1rem;
    }

    .fault-photo img {
        max-width: 100%;
        border-radius: 8px;
        margin-bottom: 1rem;
        border: 1px solid #ddd;
    }

    .fault-map {
        margin-bottom: 1.5rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
    }

    .priority-breakdown {
        margin-top: 1rem;
    }

        .priority-breakdown h4 {
            color: #009688;
            font-weight: 600;
            margin-bottom: 0.75rem;
        }

    .priority-total {
        margin-top: 0.75rem;
        font-weight: 600;
        color: #333;
    }

    .fault-actions {
        margin-top: 1.5rem;
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .audit-log {
        margin-top: 2rem;
    }

        .audit-log h4 {
            color: #009688;
            font-weight: 600;
            margin-bottom: 0.75rem;
        }

        .audit-log table {
            background: #fff;
            border-radius: 8px;
            overflow: hidden;
        }

        .audit-log th {
            background: #f4f6f9;
            font-weight: 600;
        }

    /* Back button */
    .btn-secondary {
        background-color: #6c757d;
        border: none;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

    /* Responsive tweaks */
    .fault-map {
        height: 200px;
    }

    .fault-actions {
        flex-direction: column;
    }

    }
</style>

<div class="fault-detail-container">
    <!-- Header -->
    <div class="fault-header">
        <h2>⚡ Fault Report Detail</h2>
        <p class="text-muted">View and manage the full details of this fault</p>
    </div>

    <!-- Report Content -->
    <div class="fault-content">
        <!-- Submitted Photo -->
        <div class="fault-photo">
            <img src="@Model.PhotoUrl" alt="Submitted Photo" class="fault-image" />
        </div>

        <!-- GPS Location -->
        <div class="fault-map">
            <div id="fault-map" style="height:300px; width:100%;"></div>
        </div>

        <!-- Priority Breakdown -->
        <div class="priority-breakdown">
            <h4>Priority Score Breakdown</h4>
            <ul class="list-group">
                <li class="list-group-item d-flex justify-content-between">
                    Proximity to essential services <span>35%</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    Vote count <span>20%</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    Category severity <span>25%</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    Elapsed time <span>20%</span>
                </li>
            </ul>
            <div class="priority-total">
                <strong>Total Score:</strong> @Model.PriorityScore
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="fault-actions">
        <form method="post">
            <button type="submit" asp-page-handler="Verify" class="btn btn-success">
                <i class="fas fa-check"></i> Verify Report
            </button>
            <button type="submit" asp-page-handler="Reject" class="btn btn-danger">
                <i class="fas fa-times"></i> Reject Report
            </button>
            <select name="statusUpdate" class="form-select d-inline-block w-auto">
                <option value="Pending">Pending</option>
                <option value="In Progress">In Progress</option>
                <option value="Resolved">Resolved</option>
            </select>
            <button type="submit" asp-page-handler="UpdateStatus" class="btn btn-primary">
                <i class="fas fa-sync"></i> Update Status
            </button>
        </form>
    </div>

    <!-- Audit Log -->
    <div class="audit-log">
        <h4>Audit Log</h4>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Action</th>
                    <th>Admin</th>
                    <th>Timestamp</th>
                    <th>Reason</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.AuditLogs)
                {
                    <tr>
                        <td>@log.Action</td>
                        <td>@log.AdminName</td>
                        <td>@log.Timestamp.ToString("dd MMM yyyy HH:mm")</td>
                        <td>@log.Reason</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Back to Reports -->
    <div class="mt-3">
        <a asp-page="/Reports" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Reports
        </a>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var map = L.map('fault-map').setView([@Model.Latitude, @Model.Longitude], 15);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);
        L.marker([@Model.Latitude, @Model.Longitude]).addTo(map)
            .bindPopup("Fault Location")
            .openPopup();
    </script>
}
