@page
@model FixITCity_Dashboard.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_SidebarLayout";
}

<!-- Leaflet CSS for Map -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
    <div>
        <h2>Municipal Dashboard</h2>
        <span class="text-muted"><i class="fa-solid fa-location-dot"></i> Port Elizabeth, Eastern Cape</span>
    </div>
    <div>
        <!-- High-level Filters -->
        <select class="form-select d-inline-block w-auto">
            <option>Last 30 Days</option>
            <option>Last 7 Days</option>
            <option>Today</option>
        </select>
    </div>
</div>

@if (Model.DashboardData.Alerts.Any())
{
    <div class="row mb-3">
        <div class="col-12">
            @foreach (var alert in Model.DashboardData.Alerts)
            {
                <div class="alert alert-@alert.Type py-2 px-3 mb-2" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2"></i> @alert.Message
                </div>
            }
        </div>
    </div>
}

<div class="row mb-4">
    <div class="col-md-3">
        <a href="/Reports?status=Approved" class="text-decoration-none">
            <div class="card text-white mb-3" style="background-color: #009688;">
                <div class="card-body text-center shadow-sm">
                    <h1 class="display-5">@Model.DashboardData.Statistics.ApprovedCount</h1>
                    <p class="card-text text-uppercase fw-bold">Approved Reports</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="/Reports?status=PendingApproval" class="text-decoration-none">
            <div class="card text-dark bg-light mb-3 border border-warning shadow-sm">
                <div class="card-body text-center">
                    <h1 class="display-5 text-warning">@Model.DashboardData.Statistics.PendingApprovalCount</h1>
                    <p class="card-text text-uppercase fw-bold">Pending Approval</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="/Reports?status=Unresolved" class="text-decoration-none">
            <div class="card text-dark bg-light mb-3 border border-secondary shadow-sm">
                <div class="card-body text-center">
                    <h1 class="display-5 text-secondary">@Model.DashboardData.Statistics.UnresolvedCount</h1>
                    <p class="card-text text-uppercase fw-bold">Unresolved Reports</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-3">
        <a href="/Reports?priority=Emergency" class="text-decoration-none">
            <div class="card text-white bg-danger mb-3 shadow-sm">
                <div class="card-body text-center">
                    <h1 class="display-5">@Model.DashboardData.Statistics.EmergencyCount</h1>
                    <p class="card-text text-uppercase fw-bold">Emergencies</p>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-bold">
                Report Heatmap - Geographic Density
            </div>
            <div class="card-body p-0">
                <div id="dashboard-map" style="height: 400px; width: 100%;"></div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-bold">Reports by Category</div>
            <div class="card-body">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-bold">Report Activity Trend</div>
            <div class="card-body">
                <canvas id="activityChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100 border border-danger">
            <div class="card-header bg-danger text-white fw-bold">Emergency Overview</div>
            <div class="card-body">
                <h3 class="text-danger mb-3">@Model.DashboardData.Emergencies.TotalEmergencies Emergency Reports</h3>
                <ul class="list-group list-group-flush mb-3">
                    @foreach (var emp in Model.DashboardData.Emergencies.EmergenciesByCategory)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            @emp.Key-related emergencies
                            <span class="badge bg-danger rounded-pill">@emp.Value</span>
                        </li>
                    }
                </ul>
                <a href="/Reports?priority=Emergency" class="btn btn-outline-danger w-100 mt-auto">View Emergency Reports</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Leaflet JS for Map -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script>
        // Data for Map
        var mapCenter = [@Model.DashboardData.Map.CenterLatitude, @Model.DashboardData.Map.CenterLongitude];
        var mapPoints = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DashboardData.Map.MapPoints));

        // Data for Category Chart
        var categoryLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DashboardData.Categories.ReportsByCategory.Keys));
        var categoryData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DashboardData.Categories.ReportsByCategory.Values));

        // Data for Activity Chart
        var activityLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DashboardData.Activity.ReportsByDay.Keys));
        var activityData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DashboardData.Activity.ReportsByDay.Values));
    </script>

    <script src="~/js/dashboard-map.js"></script>
    <script src="~/js/dashboard-charts.js"></script>
}
