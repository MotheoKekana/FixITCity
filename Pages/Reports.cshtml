@page
@model FixITCity_Dashboard.Pages.ReportsModel

@{
    ViewData["Title"] = "Reports";
    Layout = "_SidebarLayout";
}
<link rel="stylesheet" href="~/css/Reports.css" />

<div class="reports-container">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <div class="reports-header">

        <div>
            <h1>Reports Management</h1>
        </div>

        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">

            <a asp-page="/Reports"
               asp-page-handler="ExportCsv"
               asp-route-searchTerm="@Model.SearchTerm"
               asp-route-statusFilter="@Model.StatusFilter"
               asp-route-categoryFilter="@Model.CategoryFilter"
               class="btn btn-primary">
                <i class="fas fa-file-csv"></i>
                Export CSV
            </a>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- STATISTICS -->
    <!-- ===================================================== -->
    <div class="stats-summary">
        <div class="stat-item">
            <span class="stat-number">@Model.TotalReports</span>
            <span class="stat-label">Total Reports</span>
        </div>

        <div class="stat-item stat-open">
            <span class="stat-number">@Model.TotalPending</span>
            <span class="stat-label">Pending</span>
        </div>

        <div class="stat-item stat-assigned">
            <span class="stat-number">@Model.TotalInProgress</span>
            <span class="stat-label">In Progress</span>
        </div>

        <div class="stat-item stat-closed">
            <span class="stat-number">@Model.TotalResolved</span>
            <span class="stat-label">Resolved</span>
        </div>
    </div>
    


    <!-- ===================================================== -->
    <!-- FILTERS -->
    <!-- ===================================================== -->

    <div class="filters-bar">

        <form method="get" class="filters-form">


            <!-- SEARCH -->
            <div class="filter-group">
                <i class="fas fa-search"></i>

                <input type="text"
                       id="reportSearch"
                       name="searchTerm"
                       placeholder="Search by reference number..."
                       value="@Model.SearchTerm"
                       class="filter-input"
                       autocomplete="off" />
            </div>


            <!-- STATUS -->

            <div class="filter-group">

                <select name="statusFilter"
                        class="filter-select"
                        onchange="this.form.submit()">

                    <option value="All" selected="@(Model.StatusFilter == "All")">All Status</option>
                    <option value="Pending" selected="@(Model.StatusFilter == "Pending")">Pending</option>
                    <option value="Verified" selected="@(Model.StatusFilter == "Verified")">Verified</option>
                    <option value="InProgress" selected="@(Model.StatusFilter == "InProgress")">In Progress</option>
                    <option value="Resolved" selected="@(Model.StatusFilter == "Resolved")">Resolved</option>
                    <option value="Rejected" selected="@(Model.StatusFilter == "Rejected")">Rejected</option>

                </select>

            </div>


            <!-- CATEGORY -->

            <div class="filter-group">

                <select name="categoryFilter"
                        class="filter-select"
                        onchange="this.form.submit()">

                    <option value="All"
                            selected="@(Model.CategoryFilter == "All")">
                        All Categories
                    </option>

                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category"
                                selected="@(Model.CategoryFilter == category)">
                            @category
                        </option>
                    }

                </select>

            </div>


            <!-- DATE SORT -->

            <div class="filter-group">

                <select name="dateSort"
                        class="filter-select"
                        onchange="this.form.submit()">

                    <option value="Newest"
                            selected="@(Model.DateSort == "Newest")">
                        Newest First
                    </option>

                    <option value="Oldest"
                            selected="@(Model.DateSort == "Oldest")">
                        Oldest First
                    </option>

                </select>

            </div>


            <!-- SEARCH BUTTON -->

            <button type="submit"
                    class="btn-search">

                <i class="fas fa-search"></i>
                Search

            </button>


            <!-- CLEAR FILTERS -->

            <a asp-page="/Reports"
               class="btn-clear">

                <i class="fas fa-times"></i>
                Clear

            </a>

        </form>

    </div>


    <!-- ===================================================== -->
    <!-- REPORT TABLE -->
    <!-- ===================================================== -->

    <div class="table-container">

        @if (Model.Reports.Any())
        {
            <table class="reports-table">

                <thead>

                    <tr>
                        <th>#</th>
                        <th>Priority</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Action</th>
                    </tr>

                </thead>


                <tbody>

                    @foreach (var report in Model.Reports)
                    {
                        <tr>

                            <td>
                                <strong>
                                    #@report.ReportId
                                </strong>
                            </td>


                            <td>

                                <span class="priority-badge priority-@((report.PriorityScore ?? 0) >= 80 ? "high" : (report.PriorityScore ?? 0) >= 60 ? "medium" : "low")">

                                    @report.PriorityScore

                                </span>

                            </td>


                            <td>
                                <strong>
                                    @report.Title
                                </strong>
                            </td>


                            <td>
                                @report.CategoryName
                            </td>


                            <td>

                                <span class="status-badge status-@report.Status.ToLower()">

                                    @report.Status

                                </span>

                            </td>


                            <td>
                                @(report.CreatedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")
                            </td>


                            <td>
                                @(string.IsNullOrWhiteSpace(report.AreaName) ? "—" : report.AreaName)
                            </td>


                            <td>

                                <a asp-page="/FaultDetail"
                                   asp-route-id="@report.ReportId"
                                   class="btn-view"
                                   title="View Details">

                                    <i class="fas fa-eye"></i>

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }
      @*   else
        {
            <div class="no-results">

                <i class="fas fa-inbox"></i>

                <h4>
                    No reports found
                </h4>

                <p>
                    Try adjusting your search or filter criteria.
                </p>

            </div>
        } *@

    </div>


    <!-- ===================================================== -->
    <!-- PAGINATION -->
    <!-- ===================================================== -->
    @if (Model.TotalPages > 1)
    {
        <div class="pagination-container">

            <div class="pagination-info">

                Showing page
                @Model.CurrentPage
                of
                @Model.TotalPages

            </div>


            <div class="pagination-buttons">


                <!-- PREVIOUS -->
                @if (Model.CurrentPage > 1)
                {
                    <a href="@Url.Page(
                                               "/Reports",
                                               new
                                               {
                                                   page = Model.CurrentPage - 1,
                                                   searchTerm = Model.SearchTerm,
                                                   statusFilter = Model.StatusFilter,
                                                   categoryFilter = Model.CategoryFilter,
                                                   dateSort = Model.DateSort
                                               })"
               class="btn-pagination">

                        <i class="fas fa-chevron-left"></i>
                        Previous

                    </a>
                        }


                <!-- PAGE NUMBERS -->
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == Model.CurrentPage)
                    {
                        <span class="page-number active">
                            @i
                        </span>
                    }
                    else if (
                    i <= 3 ||
                    i > Model.TotalPages - 2 ||
                    Math.Abs(i - Model.CurrentPage) <= 1)
                    {
                        <a href="@Url.Page(
                                                       "/Reports",
                                                       new
                                                       {
                                                           page = i,
                                                           searchTerm = Model.SearchTerm,
                                                           statusFilter = Model.StatusFilter,
                                                           categoryFilter = Model.CategoryFilter,
                                                           dateSort = Model.DateSort
                                                       })"
               class="page-number">

                            @i

                        </a>
                        }
                    else if (
                    i == 4 &&
                    Model.CurrentPage > 5)
                    {
                        <span class="page-number">
                            ...
                        </span>
                    }
                    else if (
                    i == Model.TotalPages - 3 &&
                    Model.CurrentPage < Model.TotalPages - 4)
                    {
                        <span class="page-number">
                            ...
                        </span>
                    }
                }


                <!-- NEXT -->
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="@Url.Page(
                                               "/Reports",
                                               new
                                               {
                                                   page = Model.CurrentPage + 1,
                                                   searchTerm = Model.SearchTerm,
                                                   statusFilter = Model.StatusFilter,
                                                   categoryFilter = Model.CategoryFilter,
                                                   dateSort = Model.DateSort
                                               })"
               class="btn-pagination">

                        Next
                        <i class="fas fa-chevron-right"></i>

                    </a>
                        }

            </div>

        </div>
    }

</div>
<script src="~/js/Reports.js"></script>
