@page
@using FixITCity_Dashboard.Pages
@model FixITCity_Dashboard.Pages.ReportsModel

@{
    ViewData["Title"] = "Reports";
    Layout = "_SidebarLayout";
}
<link rel="stylesheet" href="~/css/Reports.css" />

<div class="reports-container">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->
    <div class="reports-header">
        <div>
            <h1>Reports Management</h1>
        </div>

        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <a asp-page="/Reports"
               asp-page-handler="ExportCsv"
               asp-route-searchTerm="@Model.SearchTerm"
               asp-route-statusFilter="@Model.StatusFilter"
               asp-route-categoryFilter="@Model.CategoryFilter"
               asp-route-dateSort="@Model.DateSort"
               class="btn btn-primary">
                <i class="fas fa-file-csv"></i>
                Export CSV
            </a>
        </div>
    </div>

    @if (Model.LoadFailed)
    {
        <div class="alert alert-warning" role="alert">
            <i class="fas fa-exclamation-triangle"></i>
            Could not load reports from the API. Statistics may be incomplete.
        </div>
    }

    <!-- ===================================================== -->
    <!-- STATISTICS -->
    <!-- ===================================================== -->
    <div class="stats-summary">

        <div class="stat-item stat-total">
            <span class="stat-number">@Model.TotalReports</span>
            <span class="stat-label">Total Reports</span>
        </div>

        @foreach (var card in Model.StatusCards)
        {
            <div class="stat-item @card.CssClass">
                <span class="stat-number">@card.Count</span>
                <span class="stat-label">@card.Label</span>
            </div>
        }

    </div>

    <!-- ===================================================== -->
    <!-- FILTERS -->
    <!-- ===================================================== -->
    <div class="filters-bar">
        <form method="get" class="filters-form">

            <!-- SEARCH -->
            <div class="filter-group">
                <i class="fas fa-search"></i>
                <input type="text"
                       id="reportSearch"
                       name="searchTerm"
                       placeholder="Search by reference number..."
                       value="@Model.SearchTerm"
                       class="filter-input"
                       autocomplete="off" />
            </div>

            <!-- STATUS -->
            <div class="filter-group">
                <select name="statusFilter"
                        class="filter-select"
                        onchange="this.form.submit()">
                    <option value="All" selected="@(Model.StatusFilter == "All")">All Status</option>

                    @foreach (var status in Model.StatusOptions)
                    {
                        <option value="@status.Label"
                                selected="@(Model.StatusFilter == status.Label)">
                            @status.Label
                        </option>
                    }
                </select>
            </div>

            <!-- CATEGORY -->
            <div class="filter-group">
                <select name="categoryFilter"
                        class="filter-select"
                        onchange="this.form.submit()">
                    <option value="All" selected="@(Model.CategoryFilter == "All")">All Categories</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category" selected="@(Model.CategoryFilter == category)">@category</option>
                    }
                </select>
            </div>

            <!-- DATE SORT -->
            <div class="filter-group">
                <select name="dateSort"
                        class="filter-select"
                        onchange="this.form.submit()">
                    <option value="Newest" selected="@(Model.DateSort == "Newest")">Newest First</option>
                    <option value="Oldest" selected="@(Model.DateSort == "Oldest")">Oldest First</option>
                </select>
            </div>

            <!-- SEARCH BUTTON -->
            <button type="submit" class="btn-search">
                <i class="fas fa-search"></i>
                Search
            </button>

            <!-- CLEAR FILTERS -->
            <a asp-page="/Reports" class="btn-clear">
                <i class="fas fa-times"></i>
                Clear
            </a>
        </form>
    </div>

    <!-- ===================================================== -->
    <!-- REPORT TABLE -->
    <!-- ===================================================== -->
    <div class="table-container">
        @if (Model.Reports.Any())
        {
            <table class="reports-table">
                <thead>
                    <tr>
                        <th>Reference Number</th>
                        <th>Priority</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var report in Model.Reports)
                    {
                        <tr>
                            <td>
                                <strong>@(string.IsNullOrWhiteSpace(report.ReferenceNumber) ? "—" : report.ReferenceNumber)</strong>
                            </td>

                            <td>
                                <span class="priority-badge priority-@((report.PriorityScore ?? 0) >= 80 ? "high" : (report.PriorityScore ?? 0) >= 60 ? "medium" : "low")">
                                    @report.PriorityScore
                                </span>
                            </td>

                            <td>
                                <strong>@report.Title</strong>
                            </td>

                            <td>
                                @report.CategoryName
                            </td>

                            <td>
                                <span class="status-badge status-@ReportsModel.NormalizeStatus(report.Status)">
                                    @report.Status
                                </span>
                            </td>

                            <td>
                                @(report.CreatedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")
                            </td>

                            <td>
                                @{
                                    var locationParts = new[]
                                    {
            report.StreetName,
            report.SuburbName ?? report.AreaName,
            report.CityName
        }
                                    .Where(p => !string.IsNullOrWhiteSpace(p))
                                    .ToList();
                                }

                                @if (locationParts.Any())
                                {
                                    @string.Join(", ", locationParts)
                                }
                                else if (report.Latitude != 0 || report.Longitude != 0)
                                {
                                    @($"{report.Latitude.ToString("F5", System.Globalization.CultureInfo.InvariantCulture)}, {report.Longitude.ToString("F5", System.Globalization.CultureInfo.InvariantCulture)}")
                                }
                                else
                                {
                                    @("—")
                                }
                            </td>

                            <td>
                                <a asp-page="/FaultDetail"
                                   asp-route-id="@report.ReportId"
                                   class="btn-view"
                                   title="View Details">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="no-results">
                <i class="fas fa-inbox"></i>
                <h4>No reports found</h4>
                <p>Try adjusting your search or filter criteria.</p>
            </div>
        }
    </div>

    <!-- ===================================================== -->
    <!-- PAGINATION -->
    <!-- ===================================================== -->
    @{
        int windowStart = Math.Max(1, Model.CurrentPage - 2);
        int windowEnd = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
    }

    @if (Model.TotalPages > 1)
    {
        <div class="pagination-container">

            <div class="pagination-info">
                Showing page @Model.CurrentPage of @Model.TotalPages
            </div>

            <div class="pagination-buttons">

                <!-- PREVIOUS -->
                @if (Model.CurrentPage > 1)
                {
                    <a href="@Url.Page("/Reports", new
                       {
                           pageNumber = Model.CurrentPage - 1,
                           searchTerm = Model.SearchTerm,
                           statusFilter = Model.StatusFilter,
                           categoryFilter = Model.CategoryFilter,
                           dateSort = Model.DateSort
                       })"
                       class="btn-pagination">
                        <i class="fas fa-chevron-left"></i>
                        Previous
                    </a>
                }

                <!-- FIRST PAGE + LEADING ELLIPSIS -->
                @if (windowStart > 1)
                {
                    <a href="@Url.Page("/Reports", new
                       {
                           pageNumber = 1,
                           searchTerm = Model.SearchTerm,
                           statusFilter = Model.StatusFilter,
                           categoryFilter = Model.CategoryFilter,
                           dateSort = Model.DateSort
                       })"
                       class="page-number">1</a>

                    if (windowStart > 2)
                    {
                        <span class="page-number">…</span>
                    }
                }

                <!-- PAGE WINDOW -->
                @for (int i = windowStart; i <= windowEnd; i++)
                {
                    if (i == Model.CurrentPage)
                    {
                        <span class="page-number active">@i</span>
                    }
                    else
                    {
                        <a href="@Url.Page("/Reports", new
                           {
                               pageNumber = i,
                               searchTerm = Model.SearchTerm,
                               statusFilter = Model.StatusFilter,
                               categoryFilter = Model.CategoryFilter,
                               dateSort = Model.DateSort
                           })"
                           class="page-number">@i</a>
                    }
                }

                <!-- TRAILING ELLIPSIS + LAST PAGE -->
                @if (windowEnd < Model.TotalPages)
                {
                    if (windowEnd < Model.TotalPages - 1)
                    {
                        <span class="page-number">…</span>
                    }

                    <a href="@Url.Page("/Reports", new
                       {
                           pageNumber = Model.TotalPages,
                           searchTerm = Model.SearchTerm,
                           statusFilter = Model.StatusFilter,
                           categoryFilter = Model.CategoryFilter,
                           dateSort = Model.DateSort
                       })"
                       class="page-number">@Model.TotalPages</a>
                }

                <!-- NEXT -->
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="@Url.Page("/Reports", new
                       {
                           pageNumber = Model.CurrentPage + 1,
                           searchTerm = Model.SearchTerm,
                           statusFilter = Model.StatusFilter,
                           categoryFilter = Model.CategoryFilter,
                           dateSort = Model.DateSort
                       })"
                       class="btn-pagination">
                        Next
                        <i class="fas fa-chevron-right"></i>
                    </a>
                }


            </div>
        </div>
    }

</div>
<script src="~/js/Reports.js"></script>