@{
    Layout = null;

    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    var username = Context.Session.GetString("FullName")
        ?? Context.Session.GetString("Username")
        ?? "Admin";
    var userInitial = string.IsNullOrWhiteSpace(username)
        ? "A"
        : username.Trim()[0].ToString().ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#123d3a" />
    <title>@ViewData["Title"] - FixITCity</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="icon" type="image/png" href="~/images/favicon.ico" />
    <link rel="stylesheet" href="~/css/sidebar-layout.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#mainContent">Skip to main content</a>

    <!-- Mobile navigation controls -->
    <button class="sidebar-toggle"
            id="hamburgerBtn"
            type="button"
            aria-label="Open navigation"
            aria-controls="sidebar"
            aria-expanded="false">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>
    <button class="sidebar-overlay"
            id="sidebarOverlay"
            type="button"
            aria-label="Close navigation"
            aria-hidden="true"
            tabindex="-1"></button>

    <aside class="sidebar" id="sidebar" aria-label="Application sidebar">
        <div class="sidebar-brand">
            <a class="sidebar-brand-link" asp-page="/Dashboard" aria-label="FixITCity dashboard">
                <span class="sidebar-logo-frame">
                    <img src="~/images/android-chrome-512x512.png" alt="" />
                </span>
                <span class="sidebar-brand-copy">
                    <span class="sidebar-brand-name">FixITCity</span>
                    <span class="sidebar-brand-caption">Municipal services portal</span>
                </span>
            </a>
        </div>

        <div class="sidebar-user">
            <span class="sidebar-avatar" aria-hidden="true">@userInitial</span>
            <span class="sidebar-user-copy">
                <span class="sidebar-user-label">Signed in</span>
                <strong class="sidebar-user-name">@username</strong>
            </span>
            <span class="sidebar-user-status" title="Signed in" aria-label="Signed in"></span>
        </div>

        <nav class="sidebar-nav" aria-label="Primary navigation">
            <a asp-page="/Dashboard"
               class="sidebar-link @(currentPage == "/Dashboard" ? "active" : "")"
               aria-current="@(currentPage == "/Dashboard" ? "page" : null)">
                <i class="fa-solid fa-gauge-high" aria-hidden="true"></i>
                <span>Dashboard</span>
            </a>

            <a asp-page="/Reports"
               class="sidebar-link @(currentPage == "/Reports" ? "active" : "")"
               aria-current="@(currentPage == "/Reports" ? "page" : null)">
                <i class="fa-solid fa-clipboard-list" aria-hidden="true"></i>
                <span>Reports</span>
            </a>

            <a asp-page="/Privacy"
               class="sidebar-link @(currentPage == "/Privacy" ? "active" : "")"
               aria-current="@(currentPage == "/Privacy" ? "page" : null)">
                <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                <span>Privacy Policy</span>
            </a>

            <a asp-page="/Settings"
               class="sidebar-link @(currentPage == "/Settings" ? "active" : "")"
               aria-current="@(currentPage == "/Settings" ? "page" : null)">
                <i class="fa-solid fa-gear" aria-hidden="true"></i>
                <span>Settings</span>
            </a>
        </nav>

        <div class="sidebar-footer">
    <form method="post"
          asp-page="/Logout"
          class="sidebar-logout-form">

        <button type="submit" class="sidebar-logout">
            <i class="fas fa-sign-out-alt" aria-hidden="true"></i>
            <span>Sign out</span>
        </button>

    </form>
</div>
    </aside>

    <main class="main-content" id="mainContent" tabindex="-1">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/sidebar-layout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
