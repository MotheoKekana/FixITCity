@{
    Layout = null;

    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    var username = Context.Session.GetString("FullName")
        ?? Context.Session.GetString("Username")
        ?? "Admin";
    var userInitial = string.IsNullOrWhiteSpace(username)
        ? "A"
        : username.Trim()[0].ToString().ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#123d3a" />
    <title>@ViewData["Title"] - FixITCity</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="icon" type="image/png" href="~/images/favicon.ico" />
    <link rel="stylesheet" href="~/css/sidebar-layout.css" asp-append-version="true" />
    <script>
    document.documentElement.dataset.theme =
        localStorage.getItem("fixitcity-theme") || "light";
</script>

<style>
    html[data-theme="dark"] body {
        background: #121820;
        color: #e5e7eb;
    }

    html[data-theme="dark"] .main-content {
        background: #121820;
        color: #e5e7eb;
    }

    html[data-theme="dark"] .sidebar {
        background: #17212b;
        color: #e5e7eb;
    }

    html[data-theme="dark"] .sidebar-brand-name,
    html[data-theme="dark"] .sidebar-brand-caption,
    html[data-theme="dark"] .sidebar-user-label,
    html[data-theme="dark"] .sidebar-user-name,
    html[data-theme="dark"] .sidebar-link {
        color: #e5e7eb;
    }

    html[data-theme="dark"] .sidebar-link:hover,
    html[data-theme="dark"] .sidebar-link.active {
        background: #263342;
        color: #fff;
    }

    html[data-theme="dark"] .settings-card,
    html[data-theme="dark"] .card,
    html[data-theme="dark"] .modal-content {
        background: #1e2935;
        color: #e5e7eb;
        border-color: #374151;
    }

    html[data-theme="dark"] .settings-card .card-header {
        background: #263342;
        border-color: #374151;
    }

    html[data-theme="dark"] h1,
    html[data-theme="dark"] h2,
    html[data-theme="dark"] h3,
    html[data-theme="dark"] h4,
    html[data-theme="dark"] h5,
    html[data-theme="dark"] label {
        color: #e5e7eb;
    }

    html[data-theme="dark"] .text-muted {
        color: #aeb8c4 !important;
    }

    html[data-theme="dark"] input,
    html[data-theme="dark"] select,
    html[data-theme="dark"] textarea,
    html[data-theme="dark"] .form-control {
        background: #263342;
        color: #e5e7eb;
        border-color: #4b5563;
    }

    html[data-theme="dark"] input::placeholder,
    html[data-theme="dark"] textarea::placeholder {
        color: #aeb8c4;
    }

    html[data-theme="dark"] table {
        color: #e5e7eb;
    }

    html[data-theme="dark"] .table {
        --bs-table-color: #e5e7eb;
        --bs-table-bg: #1e2935;
        --bs-table-border-color: #374151;
    }

    html[data-theme="dark"] .table {
    --bs-table-color: #e5e7eb;
    --bs-table-bg: #1e2935;
    --bs-table-border-color: #465365;
    --bs-table-striped-color: #e5e7eb;
    --bs-table-striped-bg: #253242;
    --bs-table-hover-color: #ffffff;
    --bs-table-hover-bg: #334155;
}

html[data-theme="dark"] .table > :not(caption) > * > * {
    color: #e5e7eb;
    background-color: var(--bs-table-bg);
    border-bottom-color: var(--bs-table-border-color);
    box-shadow: none;
}

html[data-theme="dark"] .table-striped > tbody > tr:nth-of-type(odd) > * {
    background-color: var(--bs-table-striped-bg);
}

html[data-theme="dark"] .table-hover > tbody > tr:hover > * {
    background-color: var(--bs-table-hover-bg);
    color: var(--bs-table-hover-color);
}

html[data-theme="dark"] .table thead th {
    color: #ffffff;
    background-color: #263648;
}

html[data-theme="dark"] .table a {
    color: #8bd5b2;
}

    .appearance-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
}

.appearance-title {
    display: block;
    margin-bottom: 0.25rem;
    color: #1a1a2e;
    font-weight: 600;
}

.appearance-description {
    margin: 0;
    color: #6c757d;
    font-size: 0.85rem;
}

.theme-switch {
    position: relative;
    display: inline-block;
    flex: 0 0 46px;
    width: 46px;
    height: 26px;
    margin: 0;
}

.theme-switch input {
    width: 0;
    height: 0;
    opacity: 0;
}

.theme-slider {
    position: absolute;
    inset: 0;
    cursor: pointer;
    background: #cbd5e1;
    border-radius: 26px;
    transition: background 0.2s;
}

.theme-slider::before {
    position: absolute;
    content: "";
    width: 20px;
    height: 20px;
    left: 3px;
    bottom: 3px;
    background: white;
    border-radius: 50%;
    transition: transform 0.2s;
}

.theme-switch input:checked + .theme-slider {
    background: #2d9e6b;
}

.theme-switch input:checked + .theme-slider::before {
    transform: translateX(20px);
}

.theme-switch input:focus-visible + .theme-slider {
    outline: 3px solid rgba(45, 158, 107, 0.3);
    outline-offset: 2px;
}
}

</style>
</head>
<body>
    <a class="skip-link" href="#mainContent">Skip to main content</a>

    <!-- Mobile navigation controls -->
    <button class="sidebar-toggle"
            id="hamburgerBtn"
            type="button"
            aria-label="Open navigation"
            aria-controls="sidebar"
            aria-expanded="false">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>
    <button class="sidebar-overlay"
            id="sidebarOverlay"
            type="button"
            aria-label="Close navigation"
            aria-hidden="true"
            tabindex="-1"></button>

    <aside class="sidebar" id="sidebar" aria-label="Application sidebar">
        <div class="sidebar-brand">
            <a class="sidebar-brand-link" asp-page="/Dashboard" aria-label="FixITCity dashboard">
                <span class="sidebar-logo-frame">
                    <img src="~/images/android-chrome-512x512.png" alt="" />
                </span>
                <span class="sidebar-brand-copy">
                    <span class="sidebar-brand-name">FixITCity</span>
                    <span class="sidebar-brand-caption">Municipal services portal</span>
                </span>
            </a>
        </div>

        <div class="sidebar-user">
            <span class="sidebar-avatar" aria-hidden="true">@userInitial</span>
            <span class="sidebar-user-copy">
                <span class="sidebar-user-label">Signed in</span>
                <strong class="sidebar-user-name">@username</strong>
            </span>
            <span class="sidebar-user-status" title="Signed in" aria-label="Signed in"></span>
        </div>

        <nav class="sidebar-nav" aria-label="Primary navigation">
            <a asp-page="/Dashboard"
               class="sidebar-link @(currentPage == "/Dashboard" ? "active" : "")"
               aria-current="@(currentPage == "/Dashboard" ? "page" : null)">
                <i class="fa-solid fa-gauge-high" aria-hidden="true"></i>
                <span>Dashboard</span>
            </a>

            <a asp-page="/Reports"
               class="sidebar-link @(currentPage == "/Reports" ? "active" : "")"
               aria-current="@(currentPage == "/Reports" ? "page" : null)">
                <i class="fa-solid fa-clipboard-list" aria-hidden="true"></i>
                <span>Reports</span>
            </a>

            <a asp-page="/Privacy"
               class="sidebar-link @(currentPage == "/Privacy" ? "active" : "")"
               aria-current="@(currentPage == "/Privacy" ? "page" : null)">
                <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                <span>Privacy Policy</span>
            </a>

            <a asp-page="/Settings"
               class="sidebar-link @(currentPage == "/Settings" ? "active" : "")"
               aria-current="@(currentPage == "/Settings" ? "page" : null)">
                <i class="fa-solid fa-gear" aria-hidden="true"></i>
                <span>Settings</span>
            </a>
        </nav>

        <div class="sidebar-footer">
    <form method="post"
          asp-page="/Logout"
          class="sidebar-logout-form">

        <button type="submit" class="sidebar-logout">
            <i class="fas fa-sign-out-alt" aria-hidden="true"></i>
            <span>Sign out</span>
        </button>

    </form>
</div>
    </aside>

    <main class="main-content" id="mainContent" tabindex="-1">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/sidebar-layout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
