@page "{id:long}"
@model FixITCity_Dashboard.Pages.FaultDetailModel
@{
    ViewData["Title"] = "Fault Detail";
    Layout = "_SidebarLayout";
}

<link rel="stylesheet" href="~/css/FaultDetail.css" />

<div class="fault-detail-container">

    <!-- Header -->
    <div class="fault-header">
        <h2>Fault Report Detail</h2>
        <p class="text-muted">View and manage the full details of this fault</p>
    </div>

    <!-- Report Content -->
    <div class="fault-content">

        <!-- Submitted Photo -->
        <div class="fault-photo">
            @if (Model.HasPhoto)
            {
                <img src="@Model.PhotoUrl"
                     alt="Photo submitted with this fault report"
                     loading="lazy"
                     onerror="this.onerror=null;this.src='/images/unavailable_icon.png';" />
            }
            else
            {
                <div class="fault-photo-empty">
                    <i class="fas fa-image" aria-hidden="true"></i>
                    <p>No photo was submitted with this report.</p>
                </div>
            }
        </div>

        <!-- GPS Location -->
        <div class="fault-map">
            <div id="fault-map" class="fault-map-canvas"></div>
        </div>

        <!-- Priority Breakdown -->
        <div class="priority-breakdown">
            <h4>Priority Score Breakdown</h4>
            <ul class="list-group">
                <li class="list-group-item d-flex justify-content-between">
                    Proximity to essential services <span>35%</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    Vote count <span>20%</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    Category severity <span>25%</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    Elapsed time <span>20%</span>
                </li>
            </ul>
            <div class="priority-total">
                <strong>Total Score:</strong> @Model.PriorityScore
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="fault-actions">
        <form method="post">
            <button type="submit" asp-page-handler="Verify" class="btn btn-success">
                <i class="fas fa-check"></i> Verify Report
            </button>
            <button type="submit" asp-page-handler="Reject" class="btn btn-danger">
                <i class="fas fa-times"></i> Reject Report
            </button>
            <select name="statusUpdate" class="form-select d-inline-block w-auto">
                <option value="Pending">Pending</option>
                <option value="Under Review">Under Review</option>
                <option value="Accepted">Accepted</option>
                <option value="In Progress">In Progress</option>
                <option value="Fixed">Fixed</option>
                <option value="Rejected">Rejected</option>
            </select>
            <button type="submit" asp-page-handler="UpdateStatus" class="btn btn-primary">
                <i class="fas fa-sync"></i> Update Status
            </button>
        </form>
    </div>

    <!-- Audit Log -->
    <div class="audit-log">
        <h4>Audit Log</h4>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Action</th>
                    <th>Admin</th>
                    <th>Timestamp</th>
                    <th>Reason</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.AuditLogs)
                {
                    <tr>
                        <td>@log.Action</td>
                        <td>@log.AdminName</td>
                        <td>@log.Timestamp.ToString("dd MMM yyyy HH:mm")</td>
                        <td>@log.Reason</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Back to Reports -->
    <div class="mt-3">
        <a asp-page="/Reports" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Reports
        </a>
    </div>

</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        (function () {
            const latitudeText  = '@(Model.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")';
            const longitudeText = '@(Model.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")';

            const latitude  = Number.parseFloat(latitudeText);
            const longitude = Number.parseFloat(longitudeText);

            const mapContainer = document.getElementById('fault-map');
            if (!mapContainer) return;

            if (!Number.isFinite(latitude) ||
                !Number.isFinite(longitude) ||
                (latitude === 0 && longitude === 0)) {

                mapContainer.outerHTML =
                    '<div class="fault-map-empty">' +
                    'No GPS coordinates are available for this report.' +
                    '</div>';
                return;
            }

            const map = L.map('fault-map').setView([latitude, longitude], 15);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            L.marker([latitude, longitude])
                .addTo(map)
                .bindPopup('Fault location')
                .openPopup();
        })();
    </script>
}