@page "{id:long}"
@model FixITCity_Dashboard.Pages.FaultDetailModel

@{
    ViewData["Title"] = "Fault Detail";
    Layout = "_SidebarLayout";
}

<style>
    .fault-detail-container {
        background: #ffffff;
        padding: 1.5rem;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    }

    .fault-header h2 {
        color: #009688;
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .fault-header p {
        color: #666666;
        margin-bottom: 1rem;
    }

    .fault-media {
        margin-bottom: 1.5rem;
    }

    .fault-media img {
        width: 100%;
        max-height: 450px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #dddddd;
    }

    .fault-information {
        background: #f8f9fa;
        padding: 1rem;
        margin-bottom: 1.5rem;
        border-radius: 8px;
    }

    .fault-map {
        margin-bottom: 1.5rem;
        border: 1px solid #dddddd;
        border-radius: 8px;
        overflow: hidden;
        height: 300px;
    }

    .priority-section {
        margin-top: 1rem;
    }

    .priority-section h4 {
        color: #009688;
        font-weight: 600;
        margin-bottom: 0.75rem;
    }

    .priority-total {
        padding: 1rem;
        background: #f4f6f9;
        border-radius: 8px;
        font-size: 1.1rem;
    }

    .fault-actions {
        margin-top: 1.5rem;
    }

    .action-form {
        margin-bottom: 1rem;
        padding: 1rem;
        border: 1px solid #dddddd;
        border-radius: 8px;
    }

    .audit-log {
        margin-top: 2rem;
    }

    .audit-log h4 {
        color: #009688;
        font-weight: 600;
        margin-bottom: 0.75rem;
    }

    .audit-log table {
        background: #ffffff;
    }

    .audit-log th {
        background: #f4f6f9;
        font-weight: 600;
    }

    .btn-secondary {
        background-color: #6c757d;
        border: none;
    }

    .btn-secondary:hover {
        background-color: #5a6268;
    }
</style>

<div class="fault-detail-container">

    <!-- Page heading -->
    <div class="fault-header">
        <h2>Fault Report Detail</h2>

        <p class="text-muted">
            View and manage the full details of this fault.
        </p>
    </div>

    <!-- API or database error -->
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            <strong>Unable to load report.</strong>

            <div>
                @Model.ErrorMessage
            </div>
        </div>

        <div class="mt-3">
            <a asp-page="/Reports"
               class="btn btn-secondary">

                <i class="fas fa-arrow-left"></i>
                Back to Reports
            </a>
        </div>
    }
    else
    {
        <!-- Success and error messages from form actions -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- Main report heading -->
        <div class="mb-3">
            <h3>@Model.FaultTitle</h3>

            <span class="badge bg-info text-dark">
                @Model.FaultCategory
            </span>

            <span class="badge bg-secondary">
                @Model.FaultStatus
            </span>
        </div>

        <!-- General report information -->
        <div class="fault-information">
            <div class="row">
                <div class="col-md-6">
                    <p>
                        <strong>Reference number:</strong>
                        @Model.ReferenceNumber
                    </p>

                    <p>
                        <strong>Reported:</strong>

                        @(Model.ReportedAt?.ToString(
                            "dd MMM yyyy HH:mm")
                            ?? "Date unavailable")
                    </p>
                </div>

                <div class="col-md-6">
                    <p>
                        <strong>Address:</strong>
                        @Model.Address
                    </p>

                    <p>
                        <strong>Coordinates:</strong>

                        @if (Model.HasCoordinates)
                        {
                            <span>
                                @Model.Latitude,
                                @Model.Longitude
                            </span>
                        }
                        else
                        {
                            <span>Not available</span>
                        }
                    </p>
                </div>
            </div>

            <p class="mb-0">
                <strong>Description:</strong>
                @Model.FaultDescription
            </p>
        </div>

        <!-- Supabase report image -->
        <div class="fault-media">
            <h4>Submitted Photo</h4>

            @if (Model.HasPhoto)
            {
                <img src="@Model.PhotoUrl"
                     alt="Fault report photo"
                     loading="lazy"
                     onerror="
                        this.style.display='none';
                        document.getElementById(
                            'photo-error'
                        ).style.display='block';" />

                <div id="photo-error"
                     class="alert alert-warning"
                     style="display: none;">

                    The photo URL was returned, but the browser
                    could not display the image. Check the Supabase
                    storage permissions.
                </div>
            }
            else
            {
                <div class="alert alert-secondary">
                    No photo is available for this report.
                </div>
            }
        </div>

        <!-- GPS map -->
        <h4>Fault Location</h4>

        <div class="fault-map">
            <div id="fault-map"
                 style="height: 300px; width: 100%;">
            </div>
        </div>

        <!-- Database priority score -->
        <div class="priority-section">
            <h4>Priority Score</h4>

            <div class="priority-total">
                @if (Model.PriorityScore.HasValue)
                {
                    <span>
                        <strong>Total score:</strong>
                        @Model.PriorityScore.Value.ToString("0.##")
                    </span>
                }
                else
                {
                    <span class="text-muted">
                        No priority score has been calculated.
                    </span>
                }
            </div>
        </div>

        <!-- Report actions -->
        <div class="fault-actions">
            <h4>Report Actions</h4>

            <div class="row">

                <!-- Verify -->
                <div class="col-md-4">
                    <form method="post"
                          asp-page-handler="Verify"
                          asp-route-id="@Model.ReportId"
                          class="action-form">

                        <h5>Verify Report</h5>

                        <p class="text-muted">
                            Confirm that this report is valid.
                        </p>

                        <button type="submit"
                                class="btn btn-success w-100">

                            <i class="fas fa-check"></i>
                            Verify Report
                        </button>
                    </form>
                </div>

                <!-- Reject -->
                <div class="col-md-4">
                    <form method="post"
                          asp-page-handler="Reject"
                          asp-route-id="@Model.ReportId"
                          class="action-form">

                        <h5>Reject Report</h5>

                        <div class="mb-2">
                            <label for="reason"
                                   class="form-label">

                                Rejection reason
                            </label>

                            <textarea id="reason"
                                      name="reason"
                                      class="form-control"
                                      rows="2"
                                      required
                                      placeholder="Enter the reason">
                            </textarea>
                        </div>

                        <button type="submit"
                                class="btn btn-danger w-100">

                            <i class="fas fa-times"></i>
                            Reject Report
                        </button>
                    </form>
                </div>

                <!-- Update status -->
                <div class="col-md-4">
                    <form method="post"
                          asp-page-handler="UpdateStatus"
                          asp-route-id="@Model.ReportId"
                          class="action-form">

                        <h5>Update Status</h5>

                        <div class="mb-2">
                            <label for="statusUpdate"
                                   class="form-label">

                                New status
                            </label>

                            <select id="statusUpdate"
                                    name="statusUpdate"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Select status
                                </option>

                                <option value="Pending">
                                    Pending
                                </option>

                                <option value="Verified">
                                    Verified
                                </option>

                                <option value="In Progress">
                                    In Progress
                                </option>

                                <option value="Resolved">
                                    Resolved
                                </option>
                            </select>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="fas fa-sync"></i>
                            Update Status
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Audit history -->
        <div class="audit-log">
            <h4>Audit Log</h4>

            <div class="table-responsive">
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Administrator</th>
                            <th>Timestamp</th>
                            <th>Reason</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.AuditLogs.Any())
                        {
                            @foreach (var log in Model.AuditLogs)
                            {
                                <tr>
                                    <td>@log.Action</td>

                                    <td>@log.AdminName</td>

                                    <td>
                                        @log.Timestamp
                                            .ToLocalTime()
                                            .ToString(
                                                "dd MMM yyyy HH:mm")
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(
                                            log.Reason)
                                            ? "—"
                                            : log.Reason)
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4"
                                    class="text-center text-muted">

                                    No audit logs are available.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Back button -->
        <div class="mt-3">
            <a asp-page="/Reports"
               class="btn btn-secondary">

                <i class="fas fa-arrow-left"></i>
                Back to Reports
            </a>
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
    </script>

    <script>
        const latitudeText = '@(
            Model.Latitude?.ToString(
                System.Globalization.CultureInfo.InvariantCulture)
                ?? ""
        )';

        const longitudeText = '@(
            Model.Longitude?.ToString(
                System.Globalization.CultureInfo.InvariantCulture)
                ?? ""
        )';

        const latitude = Number.parseFloat(latitudeText);
        const longitude = Number.parseFloat(longitudeText);

        const mapContainer =
            document.getElementById('fault-map');

        if (
            Number.isFinite(latitude) &&
            Number.isFinite(longitude) &&
            !(latitude === 0 && longitude === 0)
        ) {
            const map = L.map('fault-map').setView(
                [latitude, longitude],
                15
            );

            L.tileLayer(
                'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
                {
                    maxZoom: 19,
                    attribution:
                        '&copy; OpenStreetMap contributors'
                }
            ).addTo(map);

            L.marker([latitude, longitude])
                .addTo(map)
                .bindPopup('Fault location')
                .openPopup();
        }
        else {
            mapContainer.innerHTML =
                '<p class="text-center text-muted mt-5">' +
                'No GPS coordinates are available for this report.' +
                '</p>';
        }
    </script>
}