@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#009688" />
    <title>@ViewData["Title"] - FixITCity</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="icon" type="image/png" href="~/images/favicon.ico" />
    <link rel="stylesheet" href="~/css/login.css" />

    <script>
        document.documentElement.dataset.theme =
            localStorage.getItem("fixitcity-theme") || "light";
    </script>

</head>
<body>
    <main class="login-container">

        <!-- Left: brand panel -->
        <section class="login-visual">
            <div class="visual-brand">
                <h1 class="visual-name">FixIT<span>City</span></h1>
                <p class="visual-tagline">Report, Rank, Repair</p>
            </div>
        </section>

        <!-- Right: sign-in panel -->
        <section class="login-card" aria-labelledby="login-heading">

            <div class="login-intro">
                <img class="login-logo"
                     src="~/images/android-chrome-512x512.png"
                     alt="FixITCity logo" />
                <h2 id="login-heading">Welcome back</h2>
                <p>Sign in with your account to continue.</p>
            </div>

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success" role="status" aria-live="polite">
                    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                    <span>@successMessage</span>
                </div>
            }

            @if (TempData["ErrorMessage"] is string errorMessage)
            {
                <div class="alert alert-danger" role="alert" aria-live="assertive">
                    <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                    <span>@errorMessage</span>
                </div>
            }

            <form method="post" autocomplete="on" novalidate>
                <div class="form-group">
                    <label asp-for="Input.Email"></label>
                    <input asp-for="Input.Email"
                           type="email"
                           class="form-control"
                           placeholder="you@example.com"
                           autocomplete="username"
                           autocapitalize="none"
                           spellcheck="false"
                           required />
                    <span asp-validation-for="Input.Email" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Password"></label>
                    <input asp-for="Input.Password"
                           type="password"
                           class="form-control"
                           placeholder="Enter your password"
                           autocomplete="current-password"
                           maxlength="100"
                           required />
                    <span asp-validation-for="Input.Password" class="validation-message"></span>
                </div>

                <button type="submit" class="btn-login">Sign in</button>

                <div class="forgot-row">
                    <a asp-page="/ForgotPass" class="forgot-link">Forgot password?</a>
                </div>
            </form>

            <footer class="login-footer">
                <span class="brand-name">FixITCity Dashboard</span>
            </footer>
        </section>

    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>