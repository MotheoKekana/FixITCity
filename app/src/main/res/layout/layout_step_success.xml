<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_success_circle"
        android:importantForAccessibility="no"
        android:padding="14dp"
        android:src="@drawable/ic_check" />

    <TextView
        android:id="@+id/tvRedirect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/success_redirect"
        android:textColor="@color/fixit_muted"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoToSignIn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_go_to_sign_in" />

</LinearLayout>