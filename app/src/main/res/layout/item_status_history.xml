<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- LEFT: date + time -->
    <TextView
        android:id="@+id/tv_history_date"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="16 Sep 2026\n15:37" />

    <!-- CENTER: vertical line + dot -->
    <FrameLayout
        android:id="@+id/timeline_rail"
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:minHeight="72dp">

        <!-- Full-height line running behind the dot -->
        <View
            android:id="@+id/v_timeline_line"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:background="#D32F2F" />

        <!-- Dot sitting on the line -->
        <View
            android:id="@+id/v_timeline_dot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_circle_red" />
    </FrameLayout>

    <!-- RIGHT: description -->
    <TextView
        android:id="@+id/tv_history_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:textColor="@color/secondary_blue"
        android:textSize="14sp"
        tools:text="Your report has been received and is being reviewed." />

</LinearLayout>