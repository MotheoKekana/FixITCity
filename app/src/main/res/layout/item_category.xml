<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true"
    app:cardBackgroundColor="@color/surface">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">
        <ImageView
            android:id="@+id/fault_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/severity_high_bg"
            android:padding="12dp"
            android:src="@android:drawable/ic_dialog_alert"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/danger_text"
            tools:src="@android:drawable/ic_menu_report_image"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/fault_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="@color/secondary_blue"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/fault_icon"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Burst Water Pipe"
            app:layout_constraintEnd_toEndOf="parent"
            android:maxLines="2"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/fault_severity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/severity_high_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textColor="@color/danger_text"
            android:textSize="12sp"
            tools:text="⚠ Severity 10"
            app:layout_constraintStart_toStartOf="@id/fault_title"
            app:layout_constraintTop_toBottomOf="@id/fault_title"
            android:layout_marginTop="6dp" />
        <TextView
            android:id="@+id/fault_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/fault_title"
            app:layout_constraintTop_toBottomOf="@id/fault_severity"
            tools:text="Major water leak affecting pressure, flooding streets, or..." />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
