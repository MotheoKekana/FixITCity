<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:ns0="http://schemas.android.com/apk/res/android"
    xmlns:ns1="http://schemas.android.com/apk/res-auto"
    xmlns:ns2="http://schemas.android.com/tools"
    ns0:id="@+id/main"
    ns0:layout_width="match_parent"
    ns0:layout_height="match_parent"
    ns0:background="@color/background_light"
    ns0:padding="24dp">
    <com.google.android.material.card.MaterialCardView
        ns0:layout_width="match_parent"
        ns0:layout_height="wrap_content"
        ns1:cardCornerRadius="16dp"
        ns1:cardElevation="8dp"
        ns1:layout_constraintBottom_toBottomOf="parent"
        ns1:layout_constraintTop_toTopOf="parent"
        ns1:cardBackgroundColor="@color/surface">
        <LinearLayout
            ns0:layout_width="match_parent"
            ns0:layout_height="wrap_content"
            ns0:gravity="center"
            ns0:orientation="vertical"
            ns0:padding="24dp">
            <!-- Checkmark Icon -->
            <ImageView
                ns0:layout_width="80dp"
                ns0:layout_height="80dp"
                ns0:background="@drawable/bg_circle_green"
                ns0:padding="16dp"
                ns0:src="@drawable/ic_check_success"
                ns1:tint="@color/on_primary" />
            <TextView
                ns0:id="@+id/tv_success_title"
                ns0:layout_width="wrap_content"
                ns0:layout_height="wrap_content"
                ns0:layout_marginTop="24dp"
                ns0:text="Report Submitted!"
                ns0:textColor="@color/secondary_blue"
                ns0:textSize="26sp"
                ns0:textStyle="bold" />
            <TextView
                ns0:id="@+id/tv_success_message"
                ns0:layout_width="wrap_content"
                ns0:layout_height="wrap_content"
                ns0:layout_marginTop="8dp"
                ns0:gravity="center"
                ns0:text="Thank you for helping keep FixITCity safe and functional."
                ns0:textColor="@color/text_secondary" />
            <!-- Details Card -->
            <com.google.android.material.card.MaterialCardView
                ns0:layout_width="match_parent"
                ns0:layout_height="wrap_content"
                ns0:layout_marginTop="24dp"
                ns1:cardBackgroundColor="@color/surface_variant"
                ns1:cardCornerRadius="8dp"
                ns1:cardElevation="0dp">
                <LinearLayout
                    ns0:layout_width="match_parent"
                    ns0:layout_height="wrap_content"
                    ns0:orientation="vertical"
                    ns0:padding="16dp">
                    <!-- Reference Number -->
                    <LinearLayout
                        ns0:layout_width="match_parent"
                        ns0:layout_height="wrap_content"
                        ns0:orientation="horizontal"
                        ns0:gravity="center_vertical">
                        <TextView
                            ns0:layout_width="0dp"
                            ns0:layout_height="wrap_content"
                            ns0:layout_weight="1"
                            ns0:text="REFERENCE NO."
                            ns0:textColor="@color/text_secondary"
                            ns0:textSize="12sp"
                            ns0:textStyle="bold" />
                        <TextView
                            ns0:id="@+id/tv_reference_number"
                            ns0:layout_width="wrap_content"
                            ns0:layout_height="wrap_content"
                            ns0:textColor="@color/secondary_blue"
                            ns0:textSize="16sp"
                            ns0:textStyle="bold"
                            ns2:text="FIX-2024-001" />
                    </LinearLayout>
                    <View
                        ns0:layout_width="match_parent"
                        ns0:layout_height="1dp"
                        ns0:layout_marginVertical="12dp"
                        ns0:background="@color/divider" />
                    <!-- Priority Score -->
                    <LinearLayout
                        ns0:layout_width="match_parent"
                        ns0:layout_height="wrap_content"
                        ns0:orientation="horizontal"
                        ns0:gravity="center_vertical">
                        <TextView
                            ns0:layout_width="0dp"
                            ns0:layout_height="wrap_content"
                            ns0:layout_weight="1"
                            ns0:text="PRIORITY SCORE"
                            ns0:textColor="@color/text_secondary"
                            ns0:textSize="12sp"
                            ns0:textStyle="bold" />
                        <TextView
                            ns0:id="@+id/tv_priority_score"
                            ns0:layout_width="wrap_content"
                            ns0:layout_height="wrap_content"
                            ns0:background="@drawable/bg_badge_priority"
                            ns0:paddingHorizontal="8dp"
                            ns0:paddingVertical="2dp"
                            ns0:textColor="@color/status_pending_text"
                            ns2:text="92/100" />
                    </LinearLayout>
                    <!-- Status -->
                    <LinearLayout
                        ns0:layout_width="match_parent"
                        ns0:layout_height="wrap_content"
                        ns0:layout_marginTop="12dp"
                        ns0:orientation="horizontal"
                        ns0:gravity="center_vertical">
                        <TextView
                            ns0:layout_width="0dp"
                            ns0:layout_height="wrap_content"
                            ns0:layout_weight="1"
                            ns0:text="STATUS"
                            ns0:textColor="@color/text_secondary"
                            ns0:textSize="12sp"
                            ns0:textStyle="bold" />
                        <TextView
                            ns0:id="@+id/tv_status"
                            ns0:layout_width="wrap_content"
                            ns0:layout_height="wrap_content"
                            ns0:background="@drawable/bg_badge_status_received"
                            ns0:paddingHorizontal="8dp"
                            ns0:paddingVertical="2dp"
                            ns0:text="Pending"
                            ns0:textColor="@color/severity_high_text" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Copy & Share -->
            <LinearLayout
                ns0:layout_width="match_parent"
                ns0:layout_height="wrap_content"
                ns0:layout_marginTop="24dp"
                ns0:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    ns0:id="@+id/btn_copy_ref"
                    style="@style/Widget.Material3.Button.TonalButton"
                    ns0:layout_width="0dp"
                    ns0:layout_height="wrap_content"
                    ns0:layout_weight="1"
                    ns0:layout_marginEnd="8dp"
                    ns0:text="Copy Ref"
                    ns1:icon="@android:drawable/ic_menu_edit" />
                <com.google.android.material.button.MaterialButton
                    ns0:id="@+id/btn_share"
                    style="@style/Widget.Material3.Button.TonalButton"
                    ns0:layout_width="0dp"
                    ns0:layout_height="wrap_content"
                    ns0:layout_weight="1"
                    ns0:layout_marginStart="8dp"
                    ns0:text="Share"
                    ns1:icon="@android:drawable/ic_menu_share" />
            </LinearLayout>
            <!-- Go to Dashboard -->
            <com.google.android.material.button.MaterialButton
                ns0:id="@+id/btn_go_dashboard"
                ns0:layout_width="match_parent"
                ns0:layout_height="60dp"
                ns0:layout_marginTop="24dp"
                ns0:text="Go to Dashboard"
                ns0:backgroundTint="@color/primary_green"
                ns1:cornerRadius="8dp" />
            <!-- Report Another Fault -->
            <com.google.android.material.button.MaterialButton
                ns0:id="@+id/btn_report_another"
                style="@style/Widget.Material3.Button.OutlinedButton"
                ns0:layout_width="match_parent"
                ns0:layout_height="60dp"
                ns0:layout_marginTop="12dp"
                ns0:text="Report Another Fault"
                ns0:textColor="@color/secondary_blue"
                ns1:strokeColor="@color/divider"
                ns1:cornerRadius="8dp" />
            <!-- Track Report -->
            <com.google.android.material.button.MaterialButton
                ns0:id="@+id/btn_track_report"
                style="@style/Widget.Material3.Button.OutlinedButton"
                ns0:layout_width="match_parent"
                ns0:layout_height="60dp"
                ns0:layout_marginTop="12dp"
                ns0:text="Track This Report"
                ns0:textColor="@color/secondary_blue"
                ns1:strokeColor="@color/divider"
                ns1:cornerRadius="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
