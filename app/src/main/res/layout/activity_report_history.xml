<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:ns0="http://schemas.android.com/apk/res/android"
    xmlns:ns1="http://schemas.android.com/apk/res-auto"
    xmlns:ns2="http://schemas.android.com/tools"
    ns0:id="@+id/main"
    ns0:layout_width="match_parent"
    ns0:layout_height="match_parent"
    ns0:background="@color/background_main_light_blue">
    <!-- ================= Header (same as report fault) ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        ns0:id="@+id/header"
        ns0:layout_width="match_parent"
        ns0:layout_height="wrap_content"
        ns0:background="@color/surface"
        ns0:padding="16dp"
        ns1:layout_constraintTop_toTopOf="parent">
        <ImageView
            ns0:id="@+id/iv_logo"
            ns0:layout_width="32dp"
            ns0:layout_height="32dp"
            ns0:contentDescription="@string/content_desc_app_logo"
            ns0:src="@drawable/app_logo"
            ns1:layout_constraintBottom_toBottomOf="parent"
            ns1:layout_constraintStart_toStartOf="parent"
            ns1:layout_constraintTop_toTopOf="parent" />
        <TextView
            ns0:id="@+id/tvAppName"
            ns0:layout_width="wrap_content"
            ns0:layout_height="wrap_content"
            ns0:layout_marginStart="8dp"
            ns0:text="@string/app_name"
            ns0:textColor="@color/secondary_blue"
            ns0:textSize="20sp"
            ns0:textStyle="bold"
            ns1:layout_constraintBottom_toBottomOf="parent"
            ns1:layout_constraintStart_toEndOf="@id/iv_logo"
            ns1:layout_constraintTop_toTopOf="parent" />
        <ImageView
            ns0:id="@+id/ivNotifications"
            ns0:layout_width="32dp"
            ns0:layout_height="32dp"
            ns0:contentDescription="@string/content_desc_notifications"
            ns0:src="@drawable/ic_notification"
            ns1:layout_constraintBottom_toBottomOf="parent"
            ns1:layout_constraintEnd_toEndOf="parent"
            ns1:layout_constraintTop_toTopOf="parent"
            ns1:tint="@color/secondary_blue" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <!-- ================= Title ================= -->
    <TextView
        ns0:id="@+id/tv_title"
        ns0:layout_width="wrap_content"
        ns0:layout_height="wrap_content"
        ns0:layout_marginStart="16dp"
        ns0:layout_marginTop="16dp"
        ns0:text="Report History"
        ns0:textColor="@color/secondary_blue"
        ns0:textSize="28sp"
        ns0:textStyle="bold"
        ns1:layout_constraintStart_toStartOf="parent"
        ns1:layout_constraintTop_toBottomOf="@id/header" />
    <!-- Sync pending button (visible only when there are pending reports) -->
    <com.google.android.material.button.MaterialButton
        ns0:id="@+id/btn_sync_pending"
        style="@style/Widget.Material3.Button.TonalButton"
        ns0:layout_width="wrap_content"
        ns0:layout_height="wrap_content"
        ns0:layout_marginTop="8dp"
        ns0:layout_marginEnd="16dp"
        ns0:text="⟳ Sync pending (0)"
        ns0:textSize="13sp"
        ns0:visibility="gone"
        ns1:cornerRadius="20dp"
        ns1:layout_constraintEnd_toEndOf="parent"
        ns1:layout_constraintTop_toBottomOf="@id/header"
        ns2:visibility="visible" />
    <!-- ================= Filter chips ================= -->
    <HorizontalScrollView
        ns0:id="@+id/filter_scroll"
        ns0:layout_width="match_parent"
        ns0:layout_height="wrap_content"
        ns0:layout_marginTop="16dp"
        ns0:paddingStart="16dp"
        ns0:paddingEnd="16dp"
        ns0:scrollbars="none"
        ns1:layout_constraintTop_toBottomOf="@id/tv_title">
        <com.google.android.material.chip.ChipGroup
            ns0:id="@+id/chip_group_filter"
            ns0:layout_width="wrap_content"
            ns0:layout_height="wrap_content"
            ns1:singleSelection="true"
            ns1:selectionRequired="true">
            <com.google.android.material.chip.Chip
                ns0:id="@+id/chip_all"
                style="@style/Widget.Material3.Chip.Filter"
                ns0:layout_width="wrap_content"
                ns0:layout_height="wrap_content"
                ns0:checkable="true"
                ns0:checked="true"
                ns0:text="All"
                ns0:textColor="@color/filter_chip_foreground"
                ns1:chipBackgroundColor="@color/filter_chip_background"
                ns1:checkedIconTint="@color/filter_chip_foreground"
                ns1:chipStrokeColor="@color/border" />
            <com.google.android.material.chip.Chip
                ns0:id="@+id/chip_pending"
                style="@style/Widget.Material3.Chip.Filter"
                ns0:layout_width="wrap_content"
                ns0:layout_height="wrap_content"
                ns0:checkable="true"
                ns0:text="Pending"
                ns0:textColor="@color/filter_chip_foreground"
                ns1:chipBackgroundColor="@color/filter_chip_background"
                ns1:checkedIconTint="@color/filter_chip_foreground"
                ns1:chipStrokeColor="@color/border" />
            <com.google.android.material.chip.Chip
                ns0:id="@+id/chip_under_review"
                style="@style/Widget.Material3.Chip.Filter"
                ns0:layout_width="wrap_content"
                ns0:layout_height="wrap_content"
                ns0:checkable="true"
                ns0:text="Under Review"
                ns0:textColor="@color/filter_chip_foreground"
                ns1:chipBackgroundColor="@color/filter_chip_background"
                ns1:checkedIconTint="@color/filter_chip_foreground"
                ns1:chipStrokeColor="@color/border" />
            <com.google.android.material.chip.Chip
                ns0:id="@+id/chip_accepted"
                style="@style/Widget.Material3.Chip.Filter"
                ns0:layout_width="wrap_content"
                ns0:layout_height="wrap_content"
                ns0:checkable="true"
                ns0:text="Accepted"
                ns0:textColor="@color/filter_chip_foreground"
                ns1:chipBackgroundColor="@color/filter_chip_background"
                ns1:checkedIconTint="@color/filter_chip_foreground"
                ns1:chipStrokeColor="@color/border" />
            <com.google.android.material.chip.Chip
                ns0:id="@+id/chip_in_progress"
                style="@style/Widget.Material3.Chip.Filter"
                ns0:layout_width="wrap_content"
                ns0:layout_height="wrap_content"
                ns0:checkable="true"
                ns0:text="In Progress"
                ns0:textColor="@color/filter_chip_foreground"
                ns1:chipBackgroundColor="@color/filter_chip_background"
                ns1:checkedIconTint="@color/filter_chip_foreground"
                ns1:chipStrokeColor="@color/border" />
            <com.google.android.material.chip.Chip
                ns0:id="@+id/chip_fixed"
                style="@style/Widget.Material3.Chip.Filter"
                ns0:layout_width="wrap_content"
                ns0:layout_height="wrap_content"
                ns0:checkable="true"
                ns0:text="Fixed"
                ns0:textColor="@color/filter_chip_foreground"
                ns1:chipBackgroundColor="@color/filter_chip_background"
                ns1:checkedIconTint="@color/filter_chip_foreground"
                ns1:chipStrokeColor="@color/border" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    <!-- ================= Empty state ================= -->
    <TextView
        ns0:id="@+id/tv_empty_state"
        ns0:layout_width="0dp"
        ns0:layout_height="wrap_content"
        ns0:layout_marginHorizontal="24dp"
        ns0:layout_marginTop="48dp"
        ns0:gravity="center"
        ns0:text="You haven't submitted any reports yet."
        ns0:textColor="@color/text_secondary"
        ns0:textSize="16sp"
        ns0:visibility="gone"
        ns1:layout_constraintEnd_toEndOf="parent"
        ns1:layout_constraintStart_toStartOf="parent"
        ns1:layout_constraintTop_toBottomOf="@id/filter_scroll"
        ns2:visibility="visible" />
    <!-- ================= RecyclerView (cards) ================= -->
    <androidx.recyclerview.widget.RecyclerView
        ns0:id="@+id/rv_reports"
        ns0:layout_width="match_parent"
        ns0:layout_height="0dp"
        ns0:layout_marginTop="8dp"
        ns0:clipToPadding="false"
        ns0:paddingStart="16dp"
        ns0:paddingEnd="16dp"
        ns0:paddingBottom="16dp"
        ns1:layout_constraintBottom_toTopOf="@id/bottom_nav"
        ns1:layout_constraintTop_toBottomOf="@id/filter_scroll"
        ns2:itemCount="4"
        ns2:listitem="@layout/item_track_history" />
    <!-- ================= Bottom Navigation ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        ns0:id="@+id/bottom_nav"
        ns0:layout_width="match_parent"
        ns0:layout_height="72dp"
        ns0:background="@color/surface"
        ns0:elevation="8dp"
        ns1:layout_constraintBottom_toBottomOf="parent">
        <!-- Home -->
        <LinearLayout
            ns0:id="@+id/navHome"
            ns0:layout_width="0dp"
            ns0:layout_height="match_parent"
            ns0:gravity="center"
            ns0:orientation="vertical"
            ns1:layout_constraintEnd_toStartOf="@+id/navReport"
            ns1:layout_constraintStart_toStartOf="parent">
            <ImageView
                ns0:layout_width="24dp"
                ns0:layout_height="24dp"
                ns0:contentDescription="@null"
                ns0:src="@drawable/ic_home_24"
                ns1:tint="@color/icon_muted" />
            <TextView
                ns0:layout_width="wrap_content"
                ns0:layout_height="wrap_content"
                ns0:layout_marginTop="4dp"
                ns0:text="@string/nav_home"
                ns0:textColor="@color/icon_muted"
                ns0:textSize="12sp" />
        </LinearLayout>
        <!-- Report -->
        <LinearLayout
            ns0:id="@+id/navReport"
            ns0:layout_width="0dp"
            ns0:layout_height="match_parent"
            ns0:gravity="center"
            ns0:orientation="vertical"
            ns1:layout_constraintEnd_toStartOf="@+id/navTrack"
            ns1:layout_constraintStart_toEndOf="@+id/navHome">
            <ImageView
                ns0:layout_width="24dp"
                ns0:layout_height="24dp"
                ns0:contentDescription="@null"
                ns0:src="@drawable/ic_report_24"
                ns1:tint="@color/icon_muted" />
            <TextView
                ns0:layout_width="wrap_content"
                ns0:layout_height="wrap_content"
                ns0:layout_marginTop="4dp"
                ns0:text="@string/nav_report"
                ns0:textColor="@color/icon_muted"
                ns0:textSize="12sp" />
        </LinearLayout>
        <!-- Track (selected) -->
        <LinearLayout
            ns0:id="@+id/navTrack"
            ns0:layout_width="0dp"
            ns0:layout_height="match_parent"
            ns0:gravity="center"
            ns0:orientation="vertical"
            ns1:layout_constraintEnd_toStartOf="@+id/navSettings"
            ns1:layout_constraintStart_toEndOf="@+id/navReport">
            <View
                ns0:layout_width="48dp"
                ns0:layout_height="32dp"
                ns0:background="@drawable/bg_pill_white"
                ns0:backgroundTint="@color/selection_background" />
            <ImageView
                ns0:layout_width="24dp"
                ns0:layout_height="24dp"
                ns0:layout_marginTop="-28dp"
                ns0:contentDescription="@null"
                ns0:src="@drawable/ic_track_24"
                ns1:tint="@color/input_text" />
            <TextView
                ns0:layout_width="wrap_content"
                ns0:layout_height="wrap_content"
                ns0:layout_marginTop="4dp"
                ns0:text="@string/nav_track"
                ns0:textColor="@color/input_text"
                ns0:textSize="12sp"
                ns0:textStyle="bold" />
        </LinearLayout>
        <!-- Settings -->
        <LinearLayout
            ns0:id="@+id/navSettings"
            ns0:layout_width="0dp"
            ns0:layout_height="match_parent"
            ns0:gravity="center"
            ns0:orientation="vertical"
            ns1:layout_constraintEnd_toEndOf="parent"
            ns1:layout_constraintStart_toEndOf="@+id/navTrack">
            <ImageView
                ns0:layout_width="24dp"
                ns0:layout_height="24dp"
                ns0:contentDescription="@null"
                ns0:src="@drawable/ic_settings_24"
                ns1:tint="@color/icon_muted" />
            <TextView
                ns0:layout_width="wrap_content"
                ns0:layout_height="wrap_content"
                ns0:layout_marginTop="4dp"
                ns0:text="@string/nav_settings"
                ns0:textColor="@color/icon_muted"
                ns0:textSize="12sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
