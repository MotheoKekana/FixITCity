<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FixITCity" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/surface_green</item>
        <item name="colorOnPrimaryContainer">@color/severity_low_text</item>
        <item name="colorSecondary">@color/secondary_blue</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/surface_blue</item>
        <item name="colorOnSecondaryContainer">@color/secondary_blue</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border</item>
        <item name="colorError">@color/danger_text</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorErrorContainer">@color/severity_high_bg</item>
        <item name="colorOnErrorContainer">@color/severity_high_text</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorControlNormal">@color/icon_muted</item>
        <item name="colorControlActivated">@color/primary_green</item>
        <item name="android:colorBackground">@color/background_light</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:windowBackground">@color/system_bar_background</item>
        <item name="android:statusBarColor">@color/system_bar_background</item>
        <item name="android:navigationBarColor">@color/system_bar_background</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowAnimationStyle">@style/FixITCityActivityAnimation</item>

        <item name="textInputStyle">@style/Widget.FixITCity.TextInputLayout</item>
        <item name="materialButtonStyle">@style/Widget.FixITCity.Button</item>
    </style>

    <style name="FixITCityActivityAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/activity_fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/activity_fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/activity_fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/activity_fade_out</item>
    </style>

    <style name="Theme.FixITCity.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="CardViewStyle" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_radius_medium</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="android:layout_margin">@dimen/padding_small</item>
    </style>

    <style name="ButtonStyle" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.FixITCity.Button</item>
    </style>

    <style name="ShapeAppearance.FixITCity.Button" parent="">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.FixITCity.Circle" parent="">
        <item name="cornerSize">50%</item>
    </style>

</resources>